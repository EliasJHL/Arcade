digraph "IGameModule"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="IGameModule",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip="Interface pour AGameModule."];
  Node1 -> Node2 [dir="back",color="midnightblue",fontsize="10",style="solid"];
  Node2 [label="AGameModule",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classAGameModule.html",tooltip="Classe abstraite pour les libraries de jeux."];
  Node2 -> Node3 [dir="back",color="midnightblue",fontsize="10",style="solid"];
  Node3 [label="Menu",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classMenu.html",tooltip=" "];
  Node2 -> Node4 [dir="back",color="midnightblue",fontsize="10",style="solid"];
  Node4 [label="Nibbler",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classNibbler.html",tooltip=" "];
  Node2 -> Node5 [dir="back",color="midnightblue",fontsize="10",style="solid"];
  Node5 [label="Snake",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classSnake.html",tooltip=" "];
}
